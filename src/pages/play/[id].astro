---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourtDiagram from '../../components/diagrams/CourtDiagram.astro';
import Player from '../../components/diagrams/Player.astro';
import Ball from '../../components/diagrams/Ball.astro';
import MoveArrow from '../../components/diagrams/MoveArrow.astro';
import PassArrow from '../../components/diagrams/PassArrow.astro';
import Spot from '../../components/diagrams/Spot.astro';
import { puzzles, typeLabel, type Line } from '../../data/puzzles';

export function getStaticPaths() {
  return puzzles.map((puzzle, index) => ({
    params: { id: puzzle.id },
    props: { puzzle, index },
  }));
}

const { puzzle, index } = Astro.props;
const next = puzzles[index + 1];

// A lane is the same curve as a pass, drawn as a wide soft band
const lanePath = ({ x1, y1, x2, y2, curve = 0 }: Line) => {
  const len = Math.hypot(x2 - x1, y2 - y1) || 1;
  const cx = (x1 + x2) / 2 - ((y2 - y1) / len) * curve;
  const cy = (y1 + y2) / 2 + ((x2 - x1) / len) * curve;
  return `M ${x1} ${y1} Q ${cx} ${cy} ${x2} ${y2}`;
};

const describe = `${puzzle.setup} ${puzzle.question}`;
---

<BaseLayout title={`${puzzle.title} — Play`} description={describe}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12 sm:py-16" id="puzzle" data-id={puzzle.id}>

    <a href="/play" class="text-sm text-stone-400 hover:text-green-800 transition-colors mb-8 inline-block">
      ← All puzzles
    </a>

    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-50 text-[#006437]">
        {typeLabel[puzzle.type]}
      </span>
      <span class="text-xs text-stone-400">{puzzle.concept} · Puzzle {index + 1} of {puzzles.length}</span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 leading-tight mb-3">{puzzle.title}</h1>
    <p class="text-stone-500 mb-1">{puzzle.setup}</p>
    <p class="text-lg font-bold text-stone-900">{puzzle.question}</p>
    <p class="text-sm text-stone-400 mt-1">
      {puzzle.type === 'find-the-spot' ? 'Tap a dotted ring.' : 'Tap a teammate.'}
    </p>

    <CourtDiagram court="half" title={describe}>
      <!-- what the best answer opens up: hidden until solved -->
      <g id="reveal-lanes" style="display:none">
        {puzzle.reveal.lanes?.map(lane => (
          <path d={lanePath(lane)} fill="none" stroke="#c2410c" opacity="0.2" stroke-width="16" stroke-linecap="round" />
        ))}
      </g>

      {puzzle.players.filter(p => !p.target).map(p => (
        <Player x={p.x} y={p.y} label={p.label} team={p.team} />
      ))}
      <Ball x={puzzle.ball.x} y={puzzle.ball.y} />

      <g id="reveal-arrows" style="display:none">
        {puzzle.reveal.moves?.map(m => <MoveArrow {...m} color="#d97706" />)}
        {puzzle.reveal.passes?.map(p => <PassArrow {...p} />)}
      </g>

      {puzzle.spots?.map((s, i) => (
        <g class="target" role="button" tabindex="0" aria-label={`Spot ${i + 1}`}
           data-verdict={s.verdict} data-why={s.why} style="cursor:pointer">
          <Spot x={s.x} y={s.y} />
          <circle class="mark" cx={s.x} cy={s.y} r="17" fill="none" stroke="transparent" stroke-width="3" />
          <circle cx={s.x} cy={s.y} r="21" fill="transparent" />
        </g>
      ))}

      {puzzle.players.filter(p => p.target).map(p => (
        <g class="target" role="button" tabindex="0" aria-label={`Teammate ${p.label}`}
           data-verdict={p.target!.verdict} data-why={p.target!.why} style="cursor:pointer">
          <Player x={p.x} y={p.y} label={p.label} team={p.team} />
          <circle class="mark" cx={p.x} cy={p.y} r="15.5" fill="none" stroke="transparent" stroke-width="3" />
          <circle cx={p.x} cy={p.y} r="21" fill="transparent" />
        </g>
      ))}
    </CourtDiagram>

    <!-- feedback -->
    <div id="feedback" class="hidden bg-white border border-stone-200 rounded-3xl p-6" aria-live="polite">
      <p id="feedback-title" class="font-bold text-stone-900 mb-1"></p>
      <p id="feedback-why" class="text-stone-600"></p>
    </div>

    <!-- shown once solved -->
    <div id="solved" class="hidden mt-4">
      <div class="bg-emerald-50 border border-emerald-100 rounded-3xl p-6">
        <p class="text-xs font-semibold text-[#006437] uppercase tracking-widest mb-2">What to remember</p>
        <p class="text-stone-800">{puzzle.takeaway}</p>
        {puzzle.post && (
          <p class="text-sm text-stone-500 mt-3">
            For coaches and parents:
            <a href={puzzle.post.href} class="font-semibold text-[#006437] hover:underline">{puzzle.post.label} →</a>
          </p>
        )}
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-6">
        {next ? (
          <a href={`/play/${next.id}`} class="inline-flex items-center bg-[#006437] text-white font-bold text-sm px-6 py-3 rounded-full hover:bg-emerald-900 transition-colors">
            Next puzzle →
          </a>
        ) : (
          <a href="/play" class="inline-flex items-center bg-[#006437] text-white font-bold text-sm px-6 py-3 rounded-full hover:bg-emerald-900 transition-colors">
            Back to all puzzles
          </a>
        )}
        <button id="share" type="button" class="inline-flex items-center border border-stone-300 text-stone-700 font-bold text-sm px-6 py-3 rounded-full hover:border-[#006437] transition-colors cursor-pointer">
          Share this puzzle
        </button>
      </div>
    </div>

  </div>
</BaseLayout>

<style is:global>
  /* keep the focus ring for keyboards, drop it for taps */
  #puzzle .target:focus:not(:focus-visible) { outline: none; }
</style>

<script>
  const STORE = 'pws-play-v1';
  const colours: Record<string, string> = { best: '#006437', good: '#d97706', no: '#8a7a63' };
  const titles: Record<string, string> = {
    best: 'That’s the one.',
    good: 'That works. There’s an even better one.',
    no: 'Not quite. Look again.',
  };

  const root = document.getElementById('puzzle');
  const feedback = document.getElementById('feedback');
  const feedbackTitle = document.getElementById('feedback-title');
  const feedbackWhy = document.getElementById('feedback-why');
  let solved = false;

  // Progress lives on this device only; the page works without it
  const save = (id: string, verdict: string) => {
    try {
      const data = JSON.parse(localStorage.getItem(STORE) ?? '{}');
      if (data[id] !== 'best') data[id] = verdict;
      localStorage.setItem(STORE, JSON.stringify(data));
    } catch {}
  };

  const choose = (target: SVGGElement) => {
    if (solved || target.dataset.done) return;
    const verdict = target.dataset.verdict ?? 'no';
    target.querySelector('.mark')?.setAttribute('stroke', colours[verdict]);
    target.dataset.done = 'true';
    if (feedback && feedbackTitle && feedbackWhy) {
      feedbackTitle.textContent = titles[verdict];
      feedbackWhy.textContent = target.dataset.why ?? '';
      feedback.classList.remove('hidden');
    }
    if (verdict === 'no') {
      target.style.cursor = 'default';
      return;
    }
    solved = true;
    // show the best answer too, so a "good" pick still sees the lane
    document.querySelector<SVGGElement>('.target[data-verdict="best"] .mark')?.setAttribute('stroke', colours.best);
    document.querySelectorAll<SVGGElement>('#reveal-lanes, #reveal-arrows').forEach(g => (g.style.display = ''));
    document.querySelectorAll<SVGGElement>('.target').forEach(t => (t.style.cursor = 'default'));
    document.getElementById('solved')?.classList.remove('hidden');
    if (root?.dataset.id) save(root.dataset.id, verdict);
  };

  document.querySelectorAll<SVGGElement>('.target').forEach(target => {
    target.addEventListener('click', () => choose(target));
    target.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        choose(target);
      }
    });
  });

  const share = document.getElementById('share');
  share?.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url });
      } else {
        await navigator.clipboard.writeText(url);
        share.textContent = 'Link copied';
      }
    } catch {}
  });
</script>
